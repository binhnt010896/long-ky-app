<!-- Resource shrinking would otherwise drop the reminder's status-bar icon
     (it is only referenced by name from Dart); without it the notification can
     silently fail. See flutter_local_notifications, "Release build
     configuration". -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_longky" />
